# Compose environment for droplet/VM deployments.
# Copy to .env next to docker-compose.yml and fill in.

# Required — generate with: openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=

# Public URL of the app (used in emails and absolute links).
# With the default HTTP_PORT this is http://<droplet-ip>:8080
APP_URL=http://your-droplet-ip:8080

# Managed database (recommended): paste the full connection string,
# e.g. DigitalOcean → your database → Connection details → Connection string:
#   postgresql://doadmin:PASSWORD@host:25060/defaultdb?sslmode=require
# When set, this takes precedence and no local db container is needed.
DB_URL=

# Bundled Postgres only (docker-compose.local-db.yml overlay) — ignored
# when DB_URL is set.
DB_PASSWORD=change-me

# Host port the app is served on. 8080 coexists with an app already on 80;
# change to 80 if this is the only app on the droplet.
HTTP_PORT=8080

# Optional — enables AI copy polish on insights
ANTHROPIC_API_KEY=
