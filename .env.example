# Compose environment for droplet/VM deployments.
# Copy to .env next to docker-compose.yml and fill in.

# Required — generate with: openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=

# Public URL of the app (used in emails and absolute links).
# With the default HTTP_PORT this is http://<droplet-ip>:8080
APP_URL=http://your-droplet-ip:8080

# Managed database (recommended): paste the full connection string,
# e.g. DigitalOcean → your database → Connection details → Connection string:
#   postgresql://doadmin:PASSWORD@host:25060/defaultdb?sslmode=require
# When set, this takes precedence and no local db container is needed.
DB_URL=

# Bundled Postgres only (docker-compose.local-db.yml overlay) — ignored
# when DB_URL is set.
DB_PASSWORD=change-me

# Host port the app is served on. 8080 coexists with an app already on 80;
# change to 80 if this is the only app on the droplet.
HTTP_PORT=8080

# Concurrent PHP request workers (~40-80 MB RAM each).
# 2 for a 1 GB droplet shared with other apps, 4-8 with more headroom.
PHP_WORKERS=4

# Set to pull prebuilt images from GHCR instead of building on this host
# (recommended on small droplets — see "Small droplets and memory"):
#   IMAGE_PREFIX=ghcr.io/richardm8888/kickstarter-campaign-manager
IMAGE_PREFIX=
TAG=latest

# Optional — enables the AI passes: written insights, and the UX walk that
# reads a landing or Kickstarter page the way a visitor would. Without it
# the deterministic checks and scores still run, findings are just empty.
# Billed per use at console.anthropic.com; a Claude Pro plan does not cover
# API access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
